    "type": "git",
    "url": "git+https://github.com/guidomodarelli/golfo-ui.git"
  },
  "scripts": {
    "typecheck": "pnpm build && pnpm typecheck:src && pnpm typecheck:tests && pnpm typecheck:stories",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "pnpm build && vitest run",
    "test:uncompiled": "pnpm build --no-react-compiler && vitest run",
    "check": "pnpm build && pnpm lint && pnpm typecheck:src && pnpm typecheck:tests && pnpm typecheck:stories && pnpm exec vitest run",
    "lint": "oxlint",
    "test:browser": "pnpm build && playwright test",
    "test:browser:cleanup": "cleaner playwright",
    "build": "node scripts/build.js",
    "prepack": "pnpm build",
    "prepublishOnly": "golfo-rp guard-publish",
    "create-version": "golfo-rp create-version",
    "cv": "golfo-rp create-version",
    "release:prepare": "node scripts/prepare-release.js",
    "storybook": "pnpm build && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm build && storybook build",
    "typecheck:stories": "tsc --noEmit -p stories/tsconfig.json",
    "test:storybook": "pnpm build-storybook && playwright test --config playwright.storybook.config.ts"
  },
